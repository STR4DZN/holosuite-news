<section class="hn hn-prisma hn-portal {{#if reduceMotion}}hn-no-motion{{/if}}" style="--hn-font-scale: {{fontScale}}">
  <div class="hn-reading-progress" aria-hidden="true"><span></span></div>
  <div class="hn-network"><span class="hn-network-id"><i aria-hidden="true"></i>{{brand.location}}</span><span>CANAL CIVIL <b aria-hidden="true">/</b> EM TRANSMISSÃO</span></div>
  <header class="hn-masthead"><span class="hn-signal-rail" aria-hidden="true"><i></i><i></i><i></i></span>
    <button type="button" class="hn-brand" data-home aria-label="{{brand.name}} · início"><svg class="identity-mark" viewBox="0 0 80 80" aria-hidden="true"><path class="hn-mark-face" d="M21 7h38l14 15v37L59 73H21L7 59V22z"/><path class="hn-mark-facet" d="M59 7l14 15v37L59 73H40z"/><path class="hn-mark-core" d="M23 23h10v12h15V23h10v34H48V44H33v13H23z"/><ellipse class="hn-mark-orbit" cx="40" cy="40" rx="38" ry="13" transform="rotate(-34 40 40)"/><path class="hn-mark-cut" d="M13 18l5 -5M62 67l5 -5"/></svg><strong class="{{#unless brand.isHoloNews}}hn-custom-name{{/unless}}">{{#if brand.isHoloNews}}Holo<span>News</span>{{else}}{{brand.name}}{{/if}}<small>JORNAL DA REDE CIVIL</small></strong></button>
    <p>{{brand.tagline}}</p><span class="hn-edition-code"><b>CANAL ABERTO</b><small>{{brand.location}}</small><span class="edition-spectrum" aria-hidden="true"></span></span><div class="brand-orbit" aria-hidden="true"><i></i><i></i><i></i></div>
  </header>
  <nav class="hn-categories" aria-label="Categorias de notícias"><button type="button" data-category="" class="{{#if allActive}}is-active{{/if}}">Últimas notícias</button>{{#each categories}}<button type="button" data-category="{{name}}" data-tone="{{tone}}" class="{{#if active}}is-active{{/if}}">{{name}}</button>{{/each}}</nav>
  <main class="hn-paper">
    {{#if article}}<button type="button" class="hn-back" data-back>← Voltar às notícias</button>{{> "modules/holosuite-news/dist/templates/reader/article.hbs" article}}
    {{else}}{{#if unavailable}}<div class="hn-empty"><span aria-hidden="true">⌁</span><h2>Notícia indisponível</h2><p>Ela pode ter sido retirada do portal ou ter outro público.</p><button type="button" class="hn-primary" data-home>Voltar ao início</button></div>
    {{else}}
    <div class="hn-feed-heading"><div><span class="hn-overline">O MUNDO CONTINUA LÁ FORA</span><h2>{{#if category}}{{category}}{{else}}{{#if query}}Resultados da busca{{else}}Além do horizonte{{/if}}{{/if}}</h2></div><form class="hn-search" role="search" data-search><label class="hn-sr" for="hn-search">Buscar notícias</label><input id="hn-search" type="search" name="query" value="{{query}}" placeholder="Buscar no portal"><button type="submit" aria-label="Buscar">⌕</button></form></div>
    {{#if filtered}}<p class="hn-results">{{total}} notícia(s) <button type="button" data-clear>Limpar filtros</button></p>{{/if}}
    {{#if empty}}<div class="hn-empty"><span aria-hidden="true">⌁</span><h2>{{#if filtered}}Nenhuma notícia encontrada{{else}}A rede aguarda sua primeira notícia{{/if}}</h2><p>{{#if filtered}}Tente outro título, categoria ou assunto.{{else}}As notícias publicadas pelo mestre aparecerão aqui.{{/if}}</p></div>{{/if}}
    {{#if lead}}<article class="hn-lead" data-tone="{{lead.tone}}"><div class="hn-lead-text"><div class="hn-eyebrow">{{#if lead.urgent}}<span class="hn-urgent">Urgente</span>{{/if}}<span>{{lead.category}}</span><span class="hn-signal-label">REPORTAGEM DE CAPA</span></div><button type="button" class="hn-story-link" data-open="{{lead.id}}"><h1>{{lead.title}}</h1><p>{{lead.summary}}</p><span class="hn-read">Ler notícia <span aria-hidden="true">↗</span></span></button><div class="hn-card-meta"><span>{{lead.date}}{{#if lead.readingLabel}} <span class="hn-meta-dot" aria-hidden="true">·</span> {{lead.readingLabel}}{{/if}}</span><span>{{lead.viewsLabel}} visualizações</span></div></div>{{#if lead.cover}}<button type="button" class="hn-lead-image" data-open="{{lead.id}}" aria-label="Ler: {{lead.title}}"><img src="{{lead.cover}}" alt="{{lead.coverAlt}}" decoding="async"><span class="hn-image-code" aria-hidden="true">{{lead.category}} / ARQUIVO DA REDE</span></button>{{/if}}</article>{{/if}}
    {{#if cards}}<div class="hn-section-line"><h2>{{#if filtered}}Notícias{{else}}Outras frequências{{/if}}</h2><span>{{total}} transmissões no arquivo</span></div><section class="hn-grid" aria-label="Notícias">{{#each cards}}<article class="hn-card" data-tone="{{tone}}"><button type="button" class="hn-story-link" data-open="{{id}}">{{#if cover}}<div class="hn-card-image"><img src="{{cover}}" alt="{{coverAlt}}" loading="lazy" decoding="async"></div>{{/if}}<div class="hn-eyebrow">{{#if urgent}}<span class="hn-urgent">Urgente</span>{{/if}}<span>{{category}}</span></div><h3>{{title}}</h3><p>{{summary}}</p></button><div class="hn-card-meta"><span>{{date}}{{#if readingLabel}} <span class="hn-meta-dot" aria-hidden="true">·</span> {{readingLabel}}{{/if}}</span><span>{{viewsLabel}} visualizações</span></div></article>{{/each}}</section>{{/if}}
    {{#if pagination}}<nav class="hn-pagination" aria-label="Páginas de notícias"><button type="button" data-prev {{#unless hasPrev}}disabled{{/unless}}>← Anterior</button><span>{{page}} / {{pages}}</span><button type="button" data-next {{#unless hasNext}}disabled{{/unless}}>Próxima →</button></nav>{{/if}}
    {{/if}}{{/if}}
  </main>
  <footer class="hn-portal-footer"><div class="footer-identity"><svg class="identity-mark" viewBox="0 0 80 80" aria-hidden="true"><path class="hn-mark-face" d="M21 7h38l14 15v37L59 73H21L7 59V22z"/><path class="hn-mark-facet" d="M59 7l14 15v37L59 73H40z"/><path class="hn-mark-core" d="M23 23h10v12h15V23h10v34H48V44H33v13H23z"/><ellipse class="hn-mark-orbit" cx="40" cy="40" rx="38" ry="13" transform="rotate(-34 40 40)"/><path class="hn-mark-cut" d="M13 18l5 -5M62 67l5 -5"/></svg><p>Histórias de quem vive<br>entre os mundos.</p></div><strong>{{brand.name}}</strong><span>{{brand.location}}</span><div class="footer-colors" aria-hidden="true"><i></i><i></i><i></i><i></i></div></footer>
</section>
