<section class="hn hn-portal {{#if reduceMotion}}hn-no-motion{{/if}}" style="--hn-font-scale: {{fontScale}}">
  <div class="hn-reading-progress" aria-hidden="true"><span></span></div>
  <div class="hn-network"><span class="hn-network-id"><i aria-hidden="true"></i>{{brand.location}}</span><span>CANAL CIVIL <b aria-hidden="true">/</b> EM TRANSMISSÃO</span></div>
  <header class="hn-masthead"><span class="hn-signal-rail" aria-hidden="true"><i></i><i></i><i></i></span>
    <button type="button" class="hn-brand" data-home aria-label="{{brand.name}} · início"><svg viewBox="0 0 40 40" aria-hidden="true"><path d="M5 6h8v11h14V6h8v28h-8V23H13v11H5z"/><path d="M17 2h6v11h-6zm0 25h6v11h-6z" opacity=".4"/></svg><strong>{{brand.name}}</strong></button>
    <p>{{brand.tagline}}</p><span class="hn-edition-code" aria-hidden="true">HN / 01</span>
  </header>
  <nav class="hn-categories" aria-label="Categorias de notícias"><button type="button" data-category="" class="{{#if allActive}}is-active{{/if}}">Últimas notícias</button>{{#each categories}}<button type="button" data-category="{{name}}" class="{{#if active}}is-active{{/if}}">{{name}}</button>{{/each}}</nav>
  <main class="hn-paper">
    {{#if article}}<button type="button" class="hn-back" data-back>← Voltar às notícias</button>{{> "modules/holosuite-news/dist/templates/reader/article.hbs" article}}
    {{else}}{{#if unavailable}}<div class="hn-empty"><span aria-hidden="true">⌁</span><h2>Notícia indisponível</h2><p>Ela pode ter sido retirada do portal ou ter outro público.</p><button type="button" class="hn-primary" data-home>Voltar ao início</button></div>
    {{else}}
    <div class="hn-feed-heading"><div><span class="hn-overline">BOLETIM DA REDE</span><h2>{{#if category}}{{category}}{{else}}{{#if query}}Resultados da busca{{else}}O que está acontecendo{{/if}}{{/if}}</h2></div><form class="hn-search" role="search" data-search><label class="hn-sr" for="hn-search">Buscar notícias</label><input id="hn-search" type="search" name="query" value="{{query}}" placeholder="Buscar no portal"><button type="submit" aria-label="Buscar">⌕</button></form></div>
    {{#if filtered}}<p class="hn-results">{{total}} notícia(s) <button type="button" data-clear>Limpar filtros</button></p>{{/if}}
    {{#if empty}}<div class="hn-empty"><span aria-hidden="true">⌁</span><h2>{{#if filtered}}Nenhuma notícia encontrada{{else}}A rede aguarda sua primeira notícia{{/if}}</h2><p>{{#if filtered}}Tente outro título, categoria ou assunto.{{else}}As notícias publicadas pelo mestre aparecerão aqui.{{/if}}</p></div>{{/if}}
    {{#if lead}}<article class="hn-lead"><div class="hn-lead-text"><div class="hn-eyebrow">{{#if lead.urgent}}<span class="hn-urgent">Urgente</span>{{/if}}<span>{{lead.category}}</span><span class="hn-signal-label">EM DESTAQUE</span></div><button type="button" class="hn-story-link" data-open="{{lead.id}}"><h1>{{lead.title}}</h1><p>{{lead.summary}}</p><span class="hn-read">Ler notícia <span aria-hidden="true">↗</span></span></button><div class="hn-card-meta"><span>{{lead.date}}</span><span>{{lead.viewsLabel}} visualizações</span></div></div>{{#if lead.cover}}<button type="button" class="hn-lead-image" data-open="{{lead.id}}" aria-label="Ler: {{lead.title}}"><img src="{{lead.cover}}" alt="{{lead.coverAlt}}" decoding="async"><span class="hn-image-code" aria-hidden="true">ARQUIVO DA REDE / HN</span></button>{{/if}}</article>{{/if}}
    {{#if cards}}<div class="hn-section-line"><h2>{{#if filtered}}Notícias{{else}}Pela rede{{/if}}</h2><span>{{total}} transmissões no arquivo</span></div><section class="hn-grid" aria-label="Notícias">{{#each cards}}<article class="hn-card"><button type="button" class="hn-story-link" data-open="{{id}}">{{#if cover}}<div class="hn-card-image"><img src="{{cover}}" alt="{{coverAlt}}" loading="lazy" decoding="async"></div>{{/if}}<div class="hn-eyebrow">{{#if urgent}}<span class="hn-urgent">Urgente</span>{{/if}}<span>{{category}}</span></div><h3>{{title}}</h3><p>{{summary}}</p></button><div class="hn-card-meta"><span>{{date}}</span><span>{{viewsLabel}} views</span></div></article>{{/each}}</section>{{/if}}
    {{#if pagination}}<nav class="hn-pagination" aria-label="Páginas de notícias"><button type="button" data-prev {{#unless hasPrev}}disabled{{/unless}}>← Anterior</button><span>{{page}} / {{pages}}</span><button type="button" data-next {{#unless hasNext}}disabled{{/unless}}>Próxima →</button></nav>{{/if}}
    {{/if}}{{/if}}
  </main>
  <footer class="hn-portal-footer"><strong>{{brand.name}}</strong><span>{{brand.location}}</span><span class="hn-footer-signal" aria-hidden="true">● ━━ ━ ━━━</span></footer>
</section>
