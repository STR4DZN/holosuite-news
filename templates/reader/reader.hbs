<section class="hsn-reader hsn-theme-{{publication.themeId}} {{readerClasses}}" style="{{readerStyle}}" aria-label="HoloNews Reader">
  <header class="hsn-device-bar">
    <div class="hsn-device-brand"><i class="fa-solid fa-newspaper" aria-hidden="true"></i><span>HoloNews</span></div>
    {{#unless empty}}
      <div class="hsn-reader-history" aria-label="Histórico de navegação">
        <button type="button" data-hsn-action="back" aria-label="Voltar" {{#unless canBack}}disabled{{/unless}}><i class="fa-solid fa-arrow-left" aria-hidden="true"></i></button>
        <button type="button" data-hsn-action="forward" aria-label="Avançar" {{#unless canForward}}disabled{{/unless}}><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
      </div>
    {{/unless}}
    {{#if unreadCount}}<span class="hsn-unread-total" aria-label="{{unreadCount}} matérias não lidas">{{unreadCount}}</span>{{/if}}
  </header>

  {{#if isGMPreview}}<div class="hsn-preview-banner"><i class="fa-solid fa-eye" aria-hidden="true"></i> Preview como player</div>{{/if}}

  {{#if empty}}
    <main class="hsn-empty-state" data-hsn-focus tabindex="-1">
      <i class="fa-regular fa-newspaper" aria-hidden="true"></i>
      <h1>Nenhuma edição publicada</h1>
      <p>A rede está ativa, mas ainda não há notícias disponíveis para você.</p>
    </main>
  {{else}}
    <nav class="hsn-reader-nav" aria-label="Navegação do jornal">
      <button type="button" data-hsn-action="home" class="{{#if (hsnEq route.view "home")}}is-active{{/if}}"><i class="fa-solid fa-house" aria-hidden="true"></i><span>Atual</span></button>
      <button type="button" data-hsn-action="issue" data-publication-id="{{publication.id}}" data-issue-id="{{latestIssue.id}}" class="{{#if (hsnEq route.view "issue")}}is-active{{/if}}"><i class="fa-solid fa-table-columns" aria-hidden="true"></i><span>Edição</span></button>
      {{#if projection.settings.showArchive}}<button type="button" data-hsn-action="archive" class="{{#if (hsnEq route.view "archive")}}is-active{{/if}}"><i class="fa-solid fa-box-archive" aria-hidden="true"></i><span>Arquivo</span></button>{{/if}}
    </nav>

    {{#if hasMultiplePublications}}
      <nav class="hsn-publication-switcher" aria-label="Publicações disponíveis">
        {{#each publications}}<button type="button" data-hsn-action="publication" data-publication-id="{{id}}" class="{{#if (hsnEq id ../publication.id)}}is-active{{/if}}"><i class="{{icon}}" aria-hidden="true"></i><span>{{shortName}}</span></button>{{/each}}
      </nav>
    {{/if}}

    <main class="hsn-paper" data-hsn-focus tabindex="-1">
      {{#unless (hsnEq route.view "article")}}
        <header class="hsn-masthead">
          {{#if publication.logo}}<img src="{{publication.logo}}" alt="Logotipo de {{publication.name}}" class="hsn-publication-logo">{{/if}}
          <div>
            <p class="hsn-publication-location">{{publication.location}}</p>
            <h1>{{publication.name}}</h1>
            {{#if publication.slogan}}<p class="hsn-slogan">{{publication.slogan}}</p>{{/if}}
          </div>
          <div class="hsn-issue-stamp"><strong>#{{issue.number}}</strong>{{#if projection.settings.showDates}}<span>{{issue.inWorldDate}}</span>{{/if}}</div>
        </header>
      {{/unless}}

      {{#if projection.settings.allowSearch}}
        {{#unless (hsnEq route.view "article")}}
          <form class="hsn-search" data-hsn-search role="search">
            <label for="hsn-search-query" class="sr-only">Pesquisar notícias</label>
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            <input id="hsn-search-query" name="query" type="search" value="{{route.query}}" placeholder="Pesquisar notícias...">
            <button type="submit">Buscar</button>
          </form>
        {{/unless}}
      {{/if}}

      {{#if (hsnEq route.view "home")}}
        {{#if headline}}
          <article class="hsn-lead-story {{#if headline.breaking}}is-breaking{{/if}}">
            {{#if projection.settings.showBadges}}{{#if headline.breaking}}<span class="hsn-badge hsn-badge--breaking">Urgente</span>{{/if}}{{/if}}
            {{#if headline.categoryName}}<button type="button" class="hsn-category-link" data-hsn-action="category" data-category-id="{{headline.categoryId}}">{{headline.categoryName}}</button>{{/if}}
            <button type="button" class="hsn-story-link" data-hsn-action="article" data-article-id="{{headline.id}}">
              <h2>{{headline.title}}</h2>
              {{#if headline.subtitle}}<p class="hsn-deck">{{headline.subtitle}}</p>{{/if}}
              {{#if headline.heroImage}}<img src="{{headline.heroImage}}" alt="{{headline.heroImageAlt}}" class="hsn-hero-image">{{else}}<div class="hsn-image-placeholder" aria-hidden="true"><i class="fa-solid fa-satellite-dish"></i></div>{{/if}}
            </button>
            <div class="hsn-story-meta">
              {{#if projection.settings.showAuthors}}{{#if headline.authorName}}<span>Por {{headline.authorName}}</span>{{/if}}{{/if}}
              {{#if projection.settings.showViews}}<span><i class="fa-regular fa-eye" aria-hidden="true"></i> {{headline.viewsLabel}}</span>{{/if}}
              <span class="hsn-read-state {{#if headline.isRead}}is-read{{/if}}">{{#if headline.isRead}}Lida{{else}}Nova{{/if}}</span>
            </div>
          </article>
        {{/if}}
        <section class="hsn-story-grid" aria-label="Outras notícias">
          {{#each secondary}}
            <article class="hsn-story-card">
              {{#if ../projection.settings.showBadges}}{{#if badge}}<span class="hsn-badge">{{badge}}</span>{{/if}}{{/if}}
              <button type="button" class="hsn-story-link" data-hsn-action="article" data-article-id="{{id}}">
                {{#if thumbnail}}<img src="{{thumbnail}}" alt="{{heroImageAlt}}">{{/if}}
                <h3>{{title}}</h3>
                {{#if subtitle}}<p>{{subtitle}}</p>{{/if}}
              </button>
              <div class="hsn-story-meta"><span>{{categoryName}}</span>{{#if ../projection.settings.showViews}}<span><i class="fa-regular fa-eye" aria-hidden="true"></i> {{viewsLabel}}</span>{{/if}}<span class="hsn-read-dot {{#if isRead}}is-read{{/if}}" aria-label="{{#if isRead}}Lida{{else}}Nova{{/if}}"></span></div>
            </article>
          {{/each}}
        </section>
      {{/if}}

      {{#if (hsnEq route.view "issue")}}
        <header class="hsn-section-heading"><h2>{{issue.title}}</h2><p>{{articles.length}} matérias em {{pages.length}} páginas</p></header>
        <div class="hsn-page-tabs" role="list" aria-label="Páginas da edição">{{#each pages}}<button type="button" role="listitem" data-hsn-action="page" data-issue-id="{{issueId}}" data-page-id="{{id}}" class="{{#if (hsnEq id ../currentPage.id)}}is-active{{/if}}">{{pageNumber}}. {{title}}</button>{{/each}}</div>
        {{#if currentPage}}
          <section class="hsn-print-page hsn-layout-{{currentPage.layout}}" aria-label="Página {{currentPage.pageNumber}}: {{currentPage.title}}">
            {{#each pageBlocks}}
              <article class="hsn-page-block hsn-block--{{type}} hsn-span-{{span}} hsn-emphasis-{{emphasis}}">
                {{#if (hsnEq type "divider")}}<hr aria-hidden="true">{{else}}
                  {{#if article}}
                    {{#if ../projection.settings.showBadges}}{{#if article.breaking}}<span class="hsn-badge hsn-badge--breaking">Urgente</span>{{/if}}{{/if}}
                    <button type="button" class="hsn-story-link" data-hsn-action="article" data-article-id="{{article.id}}">
                      {{#if image}}<img src="{{image}}" alt="{{alt}}">{{else}}{{#if article.thumbnail}}<img src="{{article.thumbnail}}" alt="{{article.heroImageAlt}}">{{/if}}{{/if}}
                      {{#if title}}<h3>{{title}}</h3>{{else}}<h3>{{article.title}}</h3>{{/if}}
                      {{#if article.subtitle}}<p>{{article.subtitle}}</p>{{/if}}
                    </button>
                    <div class="hsn-story-meta"><span>{{article.categoryName}}</span>{{#if ../projection.settings.showViews}}<span><i class="fa-regular fa-eye" aria-hidden="true"></i> {{article.viewsLabel}}</span>{{/if}}</div>
                  {{else}}
                    {{#if author}}<div class="hsn-author-card">{{#if author.portrait}}<img src="{{author.portrait}}" alt="{{author.portraitAlt}}">{{/if}}<div><h3>{{author.name}}</h3><p>{{author.title}}</p>{{#if authorBioHtml}}<div class="hsn-block-body">{{{authorBioHtml}}}</div>{{/if}}</div></div>{{else}}
                      {{#if image}}<img src="{{image}}" alt="{{alt}}">{{/if}}
                      {{#if title}}<h3>{{title}}</h3>{{/if}}
                      {{#if bodyHtml}}<div class="hsn-block-body">{{{bodyHtml}}}</div>{{/if}}
                      {{#if linkHtml}}<div class="hsn-block-link">{{{linkHtml}}}</div>{{/if}}
                    {{/if}}
                  {{/if}}
                {{/if}}
              </article>
            {{else}}<p class="hsn-no-results">Esta página não possui blocos publicados.</p>{{/each}}
          </section>
        {{/if}}
        <header class="hsn-list-heading"><h3>Todas as notícias</h3></header>
        <section class="hsn-list-view" aria-label="Todas as notícias">
          {{#each articles}}
            <button type="button" class="hsn-list-story" data-hsn-action="article" data-article-id="{{id}}"><span class="hsn-read-dot {{#if isRead}}is-read{{/if}}"></span><span><strong>{{title}}</strong><small>{{categoryName}}{{#if ../projection.settings.showViews}} · {{viewsLabel}} visualizações{{/if}}</small></span><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
          {{/each}}
        </section>
      {{/if}}

      {{#if (hsnEq route.view "article")}}
        {{#if article}}
          <article class="hsn-article">
            <button type="button" class="hsn-back-link" data-hsn-action="back"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Voltar</button>
            <header>
              <p class="hsn-article-publication">{{publication.name}}</p>
              {{#if projection.settings.showBadges}}{{#if article.badge}}<span class="hsn-badge {{#if article.breaking}}hsn-badge--breaking{{/if}}">{{article.badge}}</span>{{/if}}{{/if}}
              <h1>{{article.title}}</h1>
              {{#if article.subtitle}}<p class="hsn-deck">{{article.subtitle}}</p>{{/if}}
              <div class="hsn-byline">
                {{#if projection.settings.showAuthors}}{{#if article.authorName}}<span>Por <strong>{{article.authorName}}</strong>{{#if article.authorRole}}, {{article.authorRole}}{{/if}}</span>{{/if}}{{/if}}
                {{#if projection.settings.showDates}}<span>{{article.inWorldDate}} {{article.inWorldTime}}</span>{{/if}}
              </div>
            </header>
            {{#if article.heroImage}}<figure><img src="{{article.heroImage}}" alt="{{article.heroImageAlt}}"><figcaption>{{article.heroImageAlt}}</figcaption></figure>{{/if}}
            <div class="hsn-article-body">{{{article.bodyHtml}}}</div>
            {{#each article.updates}}<section class="hsn-article-update"><h2>Atualização — {{time}}</h2><h3>{{title}}</h3><div>{{{bodyHtml}}}</div></section>{{/each}}
            <footer class="hsn-article-footer">{{#if projection.settings.showViews}}<span><i class="fa-regular fa-eye" aria-hidden="true"></i> {{article.viewsLabel}} visualizações</span>{{/if}}<span>{{hsnJoin article.tags " · "}}</span></footer>
          </article>
          {{#if related.length}}<aside class="hsn-related"><h2>Leia também</h2>{{#each related}}<button type="button" data-hsn-action="article" data-article-id="{{id}}">{{title}}</button>{{/each}}</aside>{{/if}}
        {{else}}<div class="hsn-empty-state"><h2>Matéria indisponível</h2><p>Este conteúdo não está publicado para o seu usuário.</p></div>{{/if}}
      {{/if}}

      {{#if (hsnEq route.view "archive")}}
        <header class="hsn-section-heading"><h2>Arquivo</h2><p>Edições publicadas e arquivadas</p></header>
        <ol class="hsn-archive-list">{{#each issues}}<li><button type="button" data-hsn-action="issue" data-publication-id="{{publicationId}}" data-issue-id="{{id}}"><span><strong>Edição #{{number}}</strong>{{#if ../projection.settings.showDates}}<small>{{inWorldDate}}</small>{{/if}}</span><span class="hsn-status">{{status}}</span></button></li>{{/each}}</ol>
      {{/if}}

      {{#if (hsnEq route.view "search")}}
        <header class="hsn-section-heading"><h2>Resultados</h2><p>{{searchResults.length}} matérias para “{{route.query}}”</p></header>
        <section class="hsn-list-view">{{#each searchResults}}<button type="button" class="hsn-list-story" data-hsn-action="article" data-article-id="{{id}}"><span><strong>{{title}}</strong><small>{{categoryName}}{{#if ../projection.settings.showViews}} · {{viewsLabel}}{{/if}}</small></span><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>{{else}}<p class="hsn-no-results">Nenhuma notícia encontrada.</p>{{/each}}</section>
      {{/if}}

      {{#if (hsnEq route.view "category")}}
        <header class="hsn-section-heading"><h2>{{#if category}}{{category.name}}{{else}}Categoria{{/if}}</h2><p>{{categoryArticles.length}} matérias</p></header>
        <section class="hsn-list-view">{{#each categoryArticles}}<button type="button" class="hsn-list-story" data-hsn-action="article" data-article-id="{{id}}"><span><strong>{{title}}</strong>{{#if ../projection.settings.showViews}}<small>{{viewsLabel}} visualizações</small>{{/if}}</span><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>{{/each}}</section>
      {{/if}}
    </main>
  {{/if}}
</section>
