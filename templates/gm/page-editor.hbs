<form class="hsn-editor-form hsn-page-form">
  <header><h1>{{#if isNew}}Nova página{{else}}Compor página{{/if}}</h1><p>Ordene blocos com os botões ou arraste os itens.</p></header>
  <div class="hsn-form-grid">
    <label>Edição<select name="issueId">{{#each issues}}<option value="{{id}}" {{hsnSelected id ../page.issueId}}>#{{number}} · {{title}}</option>{{/each}}</select></label>
    <label>Número<input name="pageNumber" type="number" min="1" value="{{page.pageNumber}}"></label>
    <label>Título<input name="title" value="{{page.title}}"></label>
    <label>Layout<select name="layout"><option value="frontpage-a" {{hsnSelected page.layout "frontpage-a"}}>Capa tradicional</option><option value="frontpage-modern" {{hsnSelected page.layout "frontpage-modern"}}>Capa moderna</option><option value="editorial" {{hsnSelected page.layout "editorial"}}>Editorial</option><option value="two-column" {{hsnSelected page.layout "two-column"}}>Duas colunas</option><option value="three-column" {{hsnSelected page.layout "three-column"}}>Três colunas</option><option value="classifieds" {{hsnSelected page.layout "classifieds"}}>Classificados</option><option value="advertisement" {{hsnSelected page.layout "advertisement"}}>Publicidade</option><option value="special" {{hsnSelected page.layout "special"}}>Especial</option><option value="crisis" {{hsnSelected page.layout "crisis"}}>Crise</option><option value="obituary" {{hsnSelected page.layout "obituary"}}>Obituário</option><option value="market" {{hsnSelected page.layout "market"}}>Mercado</option><option value="custom" {{hsnSelected page.layout "custom"}}>Customizada</option></select></label>
    <input type="hidden" name="sort" value="{{page.sort}}">
  </div>
  <section class="hsn-block-builder">
    <header><h2>Blocos</h2><button type="button" data-hsn-editor-action="block-add"><i class="fa-solid fa-plus"></i> Adicionar bloco</button></header>
    <ol>{{#each blocks}}
      <li draggable="true" data-block-id="{{id}}">
        <input type="hidden" name="blockId" value="{{id}}"><span class="hsn-drag-handle"><i class="fa-solid fa-grip-vertical"></i></span>
        <div class="hsn-block-fields">
          <label>Tipo<select name="blockType">{{#each ../blockTypes}}<option value="{{this}}" {{hsnSelected this ../type}}>{{this}}</option>{{/each}}</select></label>
          <label>Matéria<select name="blockArticleId"><option value="">Nenhuma</option>{{#each ../articles}}<option value="{{id}}" {{hsnSelected id ../articleId}}>{{title}}</option>{{/each}}</select></label>
          <label>Autor<select name="blockAuthorId"><option value="">Nenhum</option>{{#each ../authors}}<option value="{{id}}" {{hsnSelected id ../authorId}}>{{name}}</option>{{/each}}</select></label>
          <label>Título<input name="blockTitle" value="{{title}}"></label>
          <label>Imagem<input name="blockImage" value="{{image}}"><button type="button" data-hsn-editor-action="file" data-target="blockImage">Arquivos</button></label>
          <label>Alt<input name="blockAlt" value="{{alt}}"></label>
          <label>Link interno<input name="blockLink" value="{{link}}" placeholder="@UUID[Actor.x] ou URL"></label>
          <label>Destaque<select name="blockEmphasis"><option value="headline" {{hsnSelected emphasis "headline"}}>Manchete</option><option value="secondary" {{hsnSelected emphasis "secondary"}}>Secundário</option><option value="tertiary" {{hsnSelected emphasis "tertiary"}}>Terciário</option><option value="standard" {{hsnSelected emphasis "standard"}}>Padrão</option></select></label>
          <label>Colunas<select name="blockSpan"><option value="1" {{hsnSelected span 1}}>1</option><option value="2" {{hsnSelected span 2}}>2</option><option value="3" {{hsnSelected span 3}}>3</option></select></label>
          <label class="hsn-span-2">Texto<textarea name="blockBody" rows="2">{{body}}</textarea></label>
        </div>
        <div class="hsn-block-actions"><button type="button" data-hsn-editor-action="block-up" data-index="{{@index}}" aria-label="Mover acima"><i class="fa-solid fa-arrow-up"></i></button><button type="button" data-hsn-editor-action="block-down" data-index="{{@index}}" aria-label="Mover abaixo"><i class="fa-solid fa-arrow-down"></i></button><button type="button" data-hsn-editor-action="block-duplicate" data-index="{{@index}}" aria-label="Duplicar"><i class="fa-solid fa-clone"></i></button><button type="button" data-hsn-editor-action="block-delete" data-index="{{@index}}" class="hsn-danger" aria-label="Remover"><i class="fa-solid fa-trash"></i></button></div>
      </li>
    {{else}}<li class="hsn-block-empty">Esta página ainda não possui blocos.</li>{{/each}}</ol>
  </section>
  <footer><button type="submit" class="hsn-primary">Salvar página</button></footer>
</form>
