<section class="hsn-editorial" aria-label="HoloNews Mesa editorial">
  <header class="hsn-editorial-topbar">
    <div><i class="fa-solid fa-newspaper" aria-hidden="true"></i><span>HoloNews</span><small>Mesa editorial</small></div>
    <div class="hsn-topbar-actions"><button type="button" data-hsn-action="preview"><i class="fa-solid fa-eye" aria-hidden="true"></i> Preview como player</button><button type="button" data-hsn-action="quick-create" class="hsn-primary"><i class="fa-solid fa-bolt" aria-hidden="true"></i> Criação rápida</button></div>
  </header>
  <div class="hsn-editorial-layout">
    <nav class="hsn-editorial-nav" aria-label="Seções editoriais">
      <button type="button" data-hsn-action="section" data-section="dashboard" class="{{#if (hsnEq section "dashboard")}}is-active{{/if}}"><i class="fa-solid fa-gauge-high"></i><span>Dashboard</span></button>
      <button type="button" data-hsn-action="section" data-section="publications" class="{{#if (hsnEq section "publications")}}is-active{{/if}}"><i class="fa-solid fa-building-columns"></i><span>Publicações</span></button>
      <button type="button" data-hsn-action="section" data-section="issues" class="{{#if (hsnEq section "issues")}}is-active{{/if}}"><i class="fa-solid fa-copy"></i><span>Edições</span></button>
      <button type="button" data-hsn-action="section" data-section="articles" class="{{#if (hsnEq section "articles")}}is-active{{/if}}"><i class="fa-solid fa-file-lines"></i><span>Matérias</span></button>
      <button type="button" data-hsn-action="section" data-section="pages" class="{{#if (hsnEq section "pages")}}is-active{{/if}}"><i class="fa-solid fa-table-columns"></i><span>Páginas</span></button>
      <button type="button" data-hsn-action="section" data-section="authors" class="{{#if (hsnEq section "authors")}}is-active{{/if}}"><i class="fa-solid fa-user-pen"></i><span>Autores</span></button>
      <button type="button" data-hsn-action="section" data-section="categories" class="{{#if (hsnEq section "categories")}}is-active{{/if}}"><i class="fa-solid fa-tags"></i><span>Categorias</span></button>
      <button type="button" data-hsn-action="section" data-section="readership" class="{{#if (hsnEq section "readership")}}is-active{{/if}}"><i class="fa-solid fa-user-check"></i><span>Leituras reais</span></button>
      <button type="button" data-hsn-action="section" data-section="templates" class="{{#if (hsnEq section "templates")}}is-active{{/if}}"><i class="fa-solid fa-layer-group"></i><span>Templates</span></button>
      <button type="button" data-hsn-action="settings"><i class="fa-solid fa-sliders"></i><span>Configurações</span></button>
    </nav>
    <main class="hsn-editorial-workspace">
      {{#if (hsnEq section "dashboard")}}
        <header class="hsn-workspace-heading"><div><h1>Controle de publicação</h1><p>Crie, revise e publique sem expor dados administrativos aos jogadores.</p></div><span class="hsn-revision">Revisão {{state.revision}}</span></header>
        {{#unless hasContent}}<section class="hsn-editorial-empty"><i class="fa-regular fa-newspaper"></i><h2>Nenhuma publicação criada</h2><p>Comece pela criação rápida ou configure a identidade do primeiro jornal.</p><button type="button" data-hsn-action="new-publication" class="hsn-primary">Criar primeira publicação</button></section>{{else}}
          <section class="hsn-current-strip"><div><span>Edição atual</span><strong>{{#if currentIssue}}#{{currentIssue.number}} · {{currentIssue.title}}{{else}}Nenhuma publicada{{/if}}</strong></div><div><span>Visualizações narrativas</span><strong>{{totalViewsLabel}}</strong></div><div><span>Jogadores ativos</span><strong>{{players.length}}</strong></div></section>
          <section class="hsn-dashboard-columns"><div><h2>Fila editorial</h2><div class="hsn-activity-list">{{#each issues}}<button type="button" data-hsn-action="edit-issue" data-id="{{id}}"><span><strong>#{{number}} {{title}}</strong><small>{{inWorldDate}}</small></span><span class="hsn-status hsn-status--{{status}}">{{status}}</span></button>{{/each}}</div></div><div><h2>Atividade recente</h2><ol class="hsn-audit-list">{{#each auditLog}}<li><span>{{action}}</span><time>{{at}}</time></li>{{else}}<li>Nenhuma ação registrada.</li>{{/each}}</ol></div></section>
        {{/unless}}
      {{/if}}

      {{#if (hsnEq section "publications")}}<header class="hsn-workspace-heading"><div><h1>Publicações</h1><p>Identidades editoriais independentes.</p></div><button type="button" data-hsn-action="new-publication" class="hsn-primary">Nova publicação</button></header><div class="hsn-entity-list">{{#each publications}}<article><div><strong>{{name}}</strong><small>{{shortName}} · {{themeId}} · {{#if enabled}}ativa{{else}}inativa{{/if}}</small></div><div><button type="button" data-hsn-action="edit-publication" data-id="{{id}}">Editar</button><button type="button" data-hsn-action="delete-publication" data-id="{{id}}" class="hsn-danger" aria-label="Excluir {{name}}"><i class="fa-solid fa-trash"></i></button></div></article>{{/each}}</div>{{/if}}

      {{#if (hsnEq section "issues")}}<header class="hsn-workspace-heading"><div><h1>Edições</h1><p>Rascunho, publicação, arquivo e despublicação.</p></div><button type="button" data-hsn-action="new-issue" class="hsn-primary">Nova edição</button></header><div class="hsn-table-wrap"><table><thead><tr><th>Edição</th><th>Data in-world</th><th>Status</th><th>Ações</th></tr></thead><tbody>{{#each issues}}<tr><td><strong>#{{number}}</strong> {{title}}</td><td>{{inWorldDate}}</td><td><span class="hsn-status hsn-status--{{status}}">{{status}}</span></td><td class="hsn-row-actions"><button type="button" data-hsn-action="edit-issue" data-id="{{id}}" aria-label="Editar {{title}}"><i class="fa-solid fa-pen"></i></button><button type="button" data-hsn-action="preview-issue" data-id="{{id}}" aria-label="Preview {{title}}"><i class="fa-solid fa-eye"></i></button><button type="button" data-hsn-action="duplicate-issue" data-id="{{id}}" aria-label="Duplicar {{title}}"><i class="fa-solid fa-clone"></i></button><button type="button" data-hsn-action="save-template" data-id="{{id}}" aria-label="Salvar {{title}} como template"><i class="fa-solid fa-layer-group"></i></button>{{#if (hsnEq status "published")}}<button type="button" data-hsn-action="unpublish" data-id="{{id}}">Despublicar</button>{{else}}<button type="button" data-hsn-action="publish" data-id="{{id}}" class="hsn-primary">Publicar</button>{{/if}}<button type="button" data-hsn-action="archive" data-id="{{id}}">Arquivar</button><button type="button" data-hsn-action="delete-issue" data-id="{{id}}" class="hsn-danger" aria-label="Excluir {{title}}"><i class="fa-solid fa-trash"></i></button></td></tr>{{/each}}</tbody></table></div>{{/if}}

      {{#if (hsnEq section "articles")}}<header class="hsn-workspace-heading"><div><h1>Matérias</h1><p>Conteúdo, visibilidade e visualizações narrativas.</p></div><button type="button" data-hsn-action="new-article" class="hsn-primary">Nova matéria</button></header><div class="hsn-table-wrap"><table><thead><tr><th>Matéria</th><th>Status</th><th>Views</th><th>Leituras</th><th>Ações</th></tr></thead><tbody>{{#each articles}}<tr><td><strong>{{title}}</strong><small>{{category}}</small></td><td><span class="hsn-status hsn-status--{{status}}">{{status}}</span></td><td>{{viewsLabel}}</td><td>{{readCount}} / {{playerTotal}}</td><td class="hsn-row-actions"><button type="button" data-hsn-action="edit-article" data-id="{{id}}"><i class="fa-solid fa-pen"></i></button><button type="button" data-hsn-action="duplicate-article" data-id="{{id}}"><i class="fa-solid fa-clone"></i></button><button type="button" data-hsn-action="delete-article" data-id="{{id}}" class="hsn-danger"><i class="fa-solid fa-trash"></i></button></td></tr>{{/each}}</tbody></table></div>{{/if}}

      {{#if (hsnEq section "pages")}}<header class="hsn-workspace-heading"><div><h1>Páginas</h1><p>Layouts e blocos da edição.</p></div><button type="button" data-hsn-action="new-page" class="hsn-primary">Nova página</button></header><div class="hsn-entity-list">{{#each pages}}<article><div><strong>Página {{pageNumber}} · {{title}}</strong><small>{{layout}} · {{blocks.length}} blocos</small></div><div><button type="button" data-hsn-action="edit-page" data-id="{{id}}">Compor</button><button type="button" data-hsn-action="duplicate-page" data-id="{{id}}" aria-label="Duplicar {{title}}"><i class="fa-solid fa-clone"></i></button><button type="button" data-hsn-action="delete-page" data-id="{{id}}" class="hsn-danger"><i class="fa-solid fa-trash"></i></button></div></article>{{/each}}</div>{{/if}}

      {{#if (hsnEq section "authors")}}<header class="hsn-workspace-heading"><div><h1>Autores</h1><p>Assinaturas fictícias da redação.</p></div><button type="button" data-hsn-action="new-author" class="hsn-primary">Novo autor</button></header><div class="hsn-entity-list">{{#each authors}}<article><div><strong>{{name}}</strong><small>{{title}}</small></div><div><button type="button" data-hsn-action="edit-author" data-id="{{id}}">Editar</button><button type="button" data-hsn-action="delete-author" data-id="{{id}}" class="hsn-danger"><i class="fa-solid fa-trash"></i></button></div></article>{{/each}}</div>{{/if}}
      {{#if (hsnEq section "categories")}}<header class="hsn-workspace-heading"><div><h1>Categorias</h1><p>Organização e filtro editorial.</p></div><button type="button" data-hsn-action="new-category" class="hsn-primary">Nova categoria</button></header><div class="hsn-entity-list">{{#each categories}}<article><div><span class="hsn-color-dot" style="background:{{color}}"></span><strong>{{name}}</strong></div><div><button type="button" data-hsn-action="edit-category" data-id="{{id}}">Editar</button><button type="button" data-hsn-action="delete-category" data-id="{{id}}" class="hsn-danger"><i class="fa-solid fa-trash"></i></button></div></article>{{/each}}</div>{{/if}}
      {{#if (hsnEq section "readership")}}<header class="hsn-workspace-heading"><div><h1>Leituras reais</h1><p>Telemetria privada da mesa. Jogadores nunca recebem estes dados.</p></div></header><div class="hsn-table-wrap"><table><thead><tr><th>Matéria</th><th>Views fictícias</th><th>Jogadores</th><th>Quem leu</th></tr></thead><tbody>{{#each articles}}<tr><td>{{title}}</td><td>{{viewsLabel}}</td><td>{{readCount}} / {{playerTotal}}</td><td>{{#if readerNames}}{{readerNames}}{{else}}—{{/if}}</td></tr>{{/each}}</tbody></table></div>{{/if}}
      {{#if (hsnEq section "templates")}}<header class="hsn-workspace-heading"><div><h1>Templates</h1><p>Modelos recorrentes de edição e página.</p></div></header><div class="hsn-entity-list">{{#each templates}}<article><div><strong>{{name}}</strong><small>{{layout}} · {{pages.length}} páginas</small></div><div><button type="button" data-hsn-action="use-template" data-id="{{id}}" class="hsn-primary">Criar edição</button><button type="button" data-hsn-action="delete-template" data-id="{{id}}" class="hsn-danger"><i class="fa-solid fa-trash"></i></button></div></article>{{else}}<section class="hsn-editorial-empty"><h2>Nenhum template salvo</h2><p>Na lista de edições, use o botão de camadas para salvar uma estrutura recorrente.</p></section>{{/each}}</div>{{/if}}
    </main>
  </div>
  <footer class="hsn-editorial-footer"><span>Master data · GM only</span><div><button type="button" data-hsn-action="export"><i class="fa-solid fa-download"></i> Exportar JSON</button><button type="button" data-hsn-action="import"><i class="fa-solid fa-upload"></i> Importar</button><input type="file" accept="application/json,.json" data-hsn-import hidden></div></footer>
</section>
