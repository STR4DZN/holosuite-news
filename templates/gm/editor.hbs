<section class="hn hn-creator">
  <header class="hn-creator-header"><div><span class="hn-overline">HOLO<span class="hn-accent">NEWS</span> / CRIADOR</span><span class="hn-status" data-status>{{status}}</span><p class="hn-save-state" role="status" aria-live="polite" data-save-state data-state="saved">Rascunho salvo</p></div><div class="hn-header-actions"><button type="button" data-save>Salvar rascunho</button><button type="button" data-unpublish {{#unless published}}hidden{{/unless}}>Retirar do portal</button><button type="button" class="hn-primary" data-publish>{{#if published}}Publicar revisão{{else}}Publicar notícia{{/if}}</button></div></header>
  <div class="hn-creator-layout">
    <form data-editor class="hn-edit-form">
      <div class="hn-field"><label for="hn-title-{{item.id}}">Título <span>até 240 caracteres</span></label><input id="hn-title-{{item.id}}" name="title" value="{{article.title}}" maxlength="240" placeholder="O que aconteceu no seu mundo?"></div>
      <div class="hn-field"><label for="hn-summary-{{item.id}}">Resumo</label><textarea id="hn-summary-{{item.id}}" name="summary" maxlength="1200" rows="2" placeholder="Uma ou duas frases que convidam à leitura.">{{article.summary}}</textarea></div>
      <div class="hn-field"><label>Texto da notícia</label><div data-rich-editor><textarea name="body" rows="12" aria-label="Texto da notícia">{{article.body}}</textarea></div></div>
      <div class="hn-field"><label for="hn-cover-{{item.id}}">Imagem de capa</label><div class="hn-image-input"><input id="hn-cover-{{item.id}}" name="cover" value="{{article.cover}}" maxlength="2000" placeholder="Caminho ou URL da imagem"><button type="button" data-pick>Escolher</button></div><input name="coverAlt" value="{{article.coverAlt}}" maxlength="500" aria-label="Descrição da imagem" placeholder="Descrição da imagem / legenda"></div>
      <div class="hn-field-pair"><div class="hn-field"><label for="hn-category-{{item.id}}">Categoria</label><input id="hn-category-{{item.id}}" name="category" value="{{article.category}}" list="hn-category-options-{{item.id}}" maxlength="80"><datalist id="hn-category-options-{{item.id}}">{{#each categories}}<option value="{{this}}">{{/each}}</datalist></div><div class="hn-field"><label for="hn-date-{{item.id}}">Data no universo</label><input id="hn-date-{{item.id}}" name="date" value="{{article.date}}" maxlength="160" placeholder="Ex.: 24.08.2186 · 09:40"></div></div>
      <details class="hn-options" open><summary>Publicação e alcance</summary><div class="hn-options-body"><div class="hn-checks"><label><input type="checkbox" name="featured" {{hnChecked article.featured}}> Destaque na capa</label><label><input type="checkbox" name="urgent" {{hnChecked article.urgent}}> Notícia urgente</label></div><div class="hn-field-pair"><div class="hn-field"><label for="hn-views-{{item.id}}">Visualizações no universo</label><input id="hn-views-{{item.id}}" name="views" type="number" min="0" step="1" max="9007199254740991" value="{{article.views}}"><small>Contador narrativo definido por você.</small></div><div class="hn-field"><label for="hn-audience-{{item.id}}">Quem pode ler</label><select id="hn-audience-{{item.id}}" name="audience"><option value="all" {{hnSelected article.audience.mode "all"}}>Todos os jogadores</option><option value="selected" {{hnSelected article.audience.mode "selected"}}>Jogadores selecionados</option><option value="gm" {{hnSelected article.audience.mode "gm"}}>Só mestres</option></select></div></div><fieldset data-user-selection><legend>Jogadores</legend>{{#each users}}<label><input type="checkbox" name="users" value="{{id}}" {{hnChecked checked}}> {{name}}</label>{{else}}<p>Nenhum jogador cadastrado neste mundo.</p>{{/each}}</fieldset></div></details>
      <details class="hn-options"><summary>Autoria e assuntos</summary><div class="hn-options-body"><div class="hn-field"><label for="hn-author-{{item.id}}">Autor</label><input id="hn-author-{{item.id}}" name="author" value="{{article.author}}" maxlength="160" placeholder="Nome do jornalista ou da redação"></div><div class="hn-field"><label for="hn-tags-{{item.id}}">Tags</label><input id="hn-tags-{{item.id}}" name="tags" value="{{hnJoin article.tags}}" placeholder="Separe por vírgulas"></div></div></details>
      <details class="hn-options hn-private"><summary>Notas privadas do mestre</summary><div class="hn-options-body"><p>Ganchos, segredos e bastidores. Este campo fica fora da notícia publicada.</p><textarea name="notes" maxlength="100000" rows="4" aria-label="Notas privadas do mestre">{{notes}}</textarea></div></details>
    </form>
    <aside class="hn-preview-pane"><div class="hn-preview-heading"><span><i aria-hidden="true"></i> PRÉVIA DA NOTÍCIA</span><button type="button" data-preview>Atualizar ↻</button></div><div class="hn-preview-hint">O portal muda somente quando você publica.</div><div data-live-preview class="hn-preview-content"></div></aside>
  </div>
</section>
