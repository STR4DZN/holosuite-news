<form class="hsn-editor-form">
  {{#if (hsnEq kind "author")}}<header><h1>{{#if isNew}}Novo autor{{else}}Editar autor{{/if}}</h1></header><div class="hsn-form-grid"><label>Nome<input name="name" required value="{{author.name}}"></label><label>Cargo<input name="title" value="{{author.title}}"></label><label>Retrato<input name="portrait" value="{{author.portrait}}"></label><button type="button" data-hsn-editor-action="file" data-target="portrait">Arquivos</button><label class="hsn-span-2">Texto alternativo<input name="portraitAlt" value="{{author.portraitAlt}}"></label><label class="hsn-span-2">Biografia<textarea name="bio" rows="5">{{author.bio}}</textarea></label><label>Ordem<input name="sort" type="number" value="{{author.sort}}"></label></div>{{else}}<header><h1>{{#if isNew}}Nova categoria{{else}}Editar categoria{{/if}}</h1></header><div class="hsn-form-grid"><label>Nome<input name="name" required value="{{category.name}}"></label><label>Cor<input name="color" type="color" value="{{category.color}}"></label><label>Ordem<input name="sort" type="number" value="{{category.sort}}"></label></div>{{/if}}
  <footer><button type="submit" class="hsn-primary">Salvar</button></footer>
</form>
